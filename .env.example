# ============================================================================
# Local Video Analytics & Security Engine - configuration
# Copy this file to .env and edit.  (Windows: copy .env.example .env)
# Cameras are configured in config/cameras.json, zones in config/zones.json.
# ============================================================================

# ---- Web server (dashboard + API). 0.0.0.0 = reachable from phones on the Wi-Fi
HOST=0.0.0.0
PORT=8000

# ---- MQTT broker (Mosquitto). Use the laptop's LAN IP to run the broker elsewhere.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=surveillance
# 0 = at most once, 1 = at least once (recommended for events)
MQTT_QOS=1

# ---- AI models
# .pt  -> run with Ultralytics (PyTorch)      .onnx -> run with ONNX Runtime
YOLO_MODEL=models/yolov8n.pt
# Any YOLO fire/smoke model (.pt or .onnx). Leave the file out -> "NOT CONFIGURED".
FIRE_MODEL=models/fire_smoke.pt
# auto | ultralytics | onnxruntime
DETECTOR_BACKEND=auto
IMG_SIZE=640
CONFIDENCE_THRESHOLD=0.5
FIRE_CONFIDENCE_THRESHOLD=0.5

# ---- Frame sampling (performance)
# Frames analysed per second per camera (video still streams at STREAM_FPS)
PROCESS_FPS=5
STREAM_FPS=15
STREAM_WIDTH=960
STREAM_JPEG_QUALITY=70
# Run the fire model on every Nth analysed frame (every frame in Disaster Mode)
FIRE_EVERY_N_FRAMES=3
# RTSP transport: tcp (reliable) or udp (lower latency, can lose packets)
RTSP_TRANSPORT=tcp
RECONNECT_SECONDS=5

# ---- Rules
CROWD_THRESHOLD=5
LOITERING_SECONDS=10
EVENT_COOLDOWN_SECONDS=5
# Fire/smoke/crowd incidents: resolved after this many seconds without detection
INCIDENT_CLEAR_SECONDS=10
# ...and the active incident is re-published (updated) at most this often
INCIDENT_UPDATE_SECONDS=5
# Fire/smoke must be seen in this many consecutive analysed frames before alerting
FIRE_CONFIRM_FRAMES=2
PERSON_EVENTS_IN_SECURITY_MODE=false
DISASTER_MODE=false

# ---- Storage
DATABASE_PATH=database/surveillance.db
SNAPSHOT_DIR=snapshots

LOG_LEVEL=INFO
